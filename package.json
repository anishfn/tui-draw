{
  "name": "drawtui",
  "version": "1.0.2",
  "description": "A real-time multiplayer drawing & guessing game that runs entirely in the terminal, powered by Bun + @opentui/core.",
  "type": "module",
  "bin": {
    "drawtui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "tui",
    "terminal",
    "game",
    "multiplayer",
    "drawing",
    "skribbl",
    "bun",
    "opentui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepublishOnly": "bun run build",
    "server": "bun run src/server/index.ts",
    "client": "bun run src/client/index.ts",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "@opentui/core": "^0.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
